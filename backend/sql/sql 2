-- Day 2 setup for BusSaathi (Supabase)

-- Fix: column was created as update_at by mistake
alter table bus_positions rename column update_at to updated_at;

-- Trigger: the database sets updated_at, not the phone
create or replace function set_updated_at()
returns trigger as $$
begin
  new.updated_at = now();
  return new;
end;
$$ language plpgsql;

drop trigger if exists bus_positions_set_updated_at on bus_positions;

create trigger bus_positions_set_updated_at
before insert or update on bus_positions
for each row execute function set_updated_at();

-- Realtime
alter publication supabase_realtime add table bus_positions;
alter table bus_positions replica identity full;

-- Row Level Security
alter table routes enable row level security;
alter table stops enable row level security;
alter table buses enable row level security;
alter table bus_positions enable row level security;

create policy "read routes" on routes for select using (true);
create policy "read stops" on stops for select using (true);
create policy "read buses" on buses for select using (true);
create policy "read positions" on bus_positions for select using (true);

create policy "insert positions" on bus_positions
  for insert with check (true);
create policy "update positions" on bus_positions
  for update using (true) with check (true);

